class Solution {
  public:
    vector<int> nextLargerElement(vector<int>& arr) {
        
        int n = arr.size();
        vector<int> ans(n,-1);
        stack<int> st;
        for(int i=n-1; i>=0; i--){
            while(st.size()>0 and arr[i]>=st.top()) st.pop();
            ans[i] = (st.size()!=0) ? st.top() : -1;
            st.push(arr[i]);
        }
        return ans;
        
