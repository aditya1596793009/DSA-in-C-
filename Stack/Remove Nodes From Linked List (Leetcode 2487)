class Solution {
public:
    ListNode* removeNodes(ListNode* head) {
        ListNode* temp = head;
        stack<ListNode*> st;
        while(temp!=NULL){
            while(st.size()>0 and temp->val>st.top()->val) st.pop();
            st.push(temp);
            temp = temp->next;
        }
        ListNode* dum = new ListNode(-1);
        ListNode* tem = dum;
        stack<ListNode*> sta;
        while(st.size()>0){
            sta.push(st.top());
            st.pop();
        }
        while(sta.size()>0){
            tem->next = sta.top();
            sta.pop();
            tem = tem->next;
        }
        tem->next = NULL;
        return dum->next;
    }
};
