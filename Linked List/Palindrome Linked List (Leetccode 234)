class Solution {
    ListNode* reverseList(ListNode* head) {
        if(head == NULL || head->next == NULL) return head;
        ListNode* prev = NULL;
        ListNode* curr = head;
        while(curr != NULL){
            ListNode* fwd = curr->next;
            curr->next = prev;
            prev = curr;
            curr = fwd;
        }
        return prev;
    }
public:
    bool isPalindrome(ListNode* head) {
        if(head == NULL || head->next == NULL) return true;
        ListNode* temp = head;
        int len =0;
        while(temp!=NULL){
            temp = temp->next;
            len++;
        }
        temp = head;
        for(int i=1; i<len/2; i++){
            temp = temp->next;
        }
        ListNode* a = head;
        ListNode* b = temp->next;
        ListNode* c = reverseList(b);

        ListNode* t1 = a;
        ListNode* t2 = c;

        while(t2!=NULL){
            if(t1->val!=t2->val) return false;
            t1 = t1->next;
            t2 = t2->next;
        }
        return true;
    }
};
